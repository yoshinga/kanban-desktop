<Window x:Class="Kanban.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kanban.Desktop"
        xmlns:vm="clr-namespace:Kanban.Desktop.ViewModels"
        xmlns:core="clr-namespace:Kanban.Core;assembly=Kanban.Core"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Kanban" Height="920" Width="1560" MinHeight="640" MinWidth="1080"
        Icon="Assets/kanban.ico"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- ===== タグチップ (カード用・白背景+タグ色リング・ピル型) ===== -->
        <DataTemplate x:Key="CardTagChipTemplate" DataType="{x:Type vm:TagChipVm}">
            <Border CornerRadius="8" Padding="7,1" Margin="0,2,4,0" Background="#EBFFFFFF"
                    BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}" BorderThickness="1">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/>
            </Border>
        </DataTemplate>

        <!-- ===== 期限チップ ===== -->
        <DataTemplate x:Key="DueChipTemplate">
            <Border CornerRadius="8" Padding="6,1" Margin="0,2,4,0"
                    Background="{Binding DueStatus, Converter={StaticResource DueBrush}, ConverterParameter=bg}"
                    BorderBrush="{Binding DueStatus, Converter={StaticResource DueBrush}, ConverterParameter=ring}"
                    BorderThickness="1"
                    ToolTip="{Binding DueText, StringFormat='期限: {0}'}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CalendarIcon}" StrokeThickness="1.6"
                          Stroke="{Binding DueStatus, Converter={StaticResource DueBrush}, ConverterParameter=fg}"
                          Stretch="Uniform" Width="9" Height="9"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DueText}" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0"
                               Foreground="{Binding DueStatus, Converter={StaticResource DueBrush}, ConverterParameter=fg}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== サイドバーの 1 行 (すべて / 今日 / カテゴリタグ) ===== -->
        <DataTemplate x:Key="SidebarRowTemplate" DataType="{x:Type vm:SidebarTagVm}">
            <Grid>
                <!-- 展開時 -->
                <Grid x:Name="Expanded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                             Visibility="{Binding HasEmoji, Converter={StaticResource InvBoolToVis}}"/>
                    <emoji:TextBlock Text="{Binding Emoji}" FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasEmoji, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <Border Grid.Column="2" CornerRadius="7" Padding="6,1" VerticalAlignment="Center"
                            Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#525252"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
                <!-- 折りたたみ時: 丸 + 件数バッジ -->
                <Grid x:Name="Collapsed" Visibility="Collapsed" Height="18" Width="30" HorizontalAlignment="Center">
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                             Visibility="{Binding HasEmoji, Converter={StaticResource InvBoolToVis}}"/>
                    <emoji:TextBlock Text="{Binding Emoji}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasEmoji, Converter={StaticResource BoolToVis}}"/>
                    <Border CornerRadius="6" Background="#3B82F6" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-1,0"
                            Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Count}" FontSize="8.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </Border>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="Expanded" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Collapsed" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- サイドバーのグループ見出し (クリックで開閉。IsChecked = 開いている) -->
        <Style x:Key="SidebarGroupToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="6,3,6,0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Chevron" Data="M 1.5,3 L 4.5,6 L 7.5,3" Stroke="#A3A3A3" StrokeThickness="1.4"
                                      Width="9" Height="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="0,1,5,0" RenderTransformOrigin="0.5,0.5"/>
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource SectionHeader}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== アイテムカード (ボード・検索結果で共用) ===== -->
        <DataTemplate x:Key="ItemCardTemplate" DataType="{x:Type vm:ItemCardVm}">
            <!-- 外枠: カード間の隙間 (下 8px) も含めてドロップ判定する（隙間でカラム扱いになってちらつかないように） -->
            <Border x:Name="DropArea" Background="Transparent" Padding="0,0,0,8" AllowDrop="True"
                    Tag="{Binding ElementName=Card}"
                    DragEnter="Card_DragOver" DragOver="Card_DragOver" Drop="Card_Drop">
            <StackPanel>
                <!-- 落とし先スロット (Trello 風にカードを押しのけて隙間を開ける) -->
                <Border x:Name="TopSlot" Height="{Binding SlotHeight}" CornerRadius="16" Margin="0,0,0,8"
                        Background="#E2E4E9" AllowDrop="True" Visibility="Collapsed"/>
            <Grid x:Name="CardRoot">
                <!-- ホバー時の影は文字を含まない背面レイヤーに掛ける。
                     カード本体に Effect を掛けると中の文字まで画像化されてぼやけるため -->
                <Border x:Name="CardShadow" CornerRadius="16" Background="#FFFFFF" Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#0F172A"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="Card" Padding="12,10" CornerRadius="16" BorderThickness="1"
                        AllowDrop="True" Cursor="Hand"
                        PreviewMouseLeftButtonDown="Card_MouseDown"
                        PreviewMouseMove="Card_MouseMove"
                        PreviewMouseLeftButtonUp="Card_MouseUp"
                        MouseRightButtonUp="Card_RightClick">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding PastelKey, Converter={StaticResource PastelBrush}}"/>
                            <!-- 常時の影は付けない（カード数百枚に Effect を掛けると描画が重くなる）。影はホバー時のみ -->
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Dragging}" Value="True">
                                    <Setter Property="Opacity" Value="0"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#D4D4D4"/>
                                </Trigger>
                                <!-- Ctrl+クリックで選択中 -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- ヘッダー行: 連番バッジ + 期限チップ + タグ -->
                        <WrapPanel Margin="0,0,0,7"
                                   Visibility="{Binding HasHeaderRow, Converter={StaticResource BoolToVis}}">
                            <Border Height="18" MinWidth="18" CornerRadius="5" Padding="5,0" Margin="0,2,8,0"
                                    Visibility="{Binding ShowSequence, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding Sequence, StringFormat='#{0}'}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#A3A3A3" Offset="0"/>
                                                    <GradientStop Color="#737373" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sequence}" Value="1">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                                            <GradientStop Color="#2563EB" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Sequence}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Content="{Binding}"
                                              ContentTemplate="{StaticResource DueChipTemplate}"
                                              Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding VisibleTags}"
                                          ItemTemplate="{StaticResource CardTagChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding MoreTagsCount, StringFormat='+{0}'}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,2,0,0"
                                       Visibility="{Binding MoreTagsCount, Converter={StaticResource IntToVis}}"/>
                            <TextBlock Text="{Binding ContextText, StringFormat='· {0}'}" FontSize="10"
                                       Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"
                                       Margin="2,2,0,0"
                                       Visibility="{Binding ContextText, Converter={StaticResource StringToVis}}"/>
                        </WrapPanel>

                        <!-- インジケータ行: 本文 / サブタスク / コメント -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding HasIndicators, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource DocIcon}" Stroke="#A3A3A3" StrokeThickness="1.5"
                                  Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  ToolTip="説明あり"
                                  Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                        Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource ListIcon}" Stroke="#A3A3A3" StrokeThickness="1.5"
                                      Stretch="Uniform" Width="12" Height="12"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="{Binding SubtaskText}" FontSize="10" Foreground="#A3A3A3"
                                           Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource CommentIcon}" Stroke="#A3A3A3" StrokeThickness="1.5"
                                      Stretch="Uniform" Width="12" Height="12"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="{Binding CommentsCount}" FontSize="10" Foreground="#A3A3A3"
                                           Margin="2,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding ShowCommentsCount, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- タイトル行: 優先度フラグ + #番号 + タイトル (1 つの TextBlock で折り返す) -->
                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dimmed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TitleBold}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <InlineUIContainer BaselineAlignment="Center">
                                <Path Data="{StaticResource FlagIcon}" Stroke="#EF4444" StrokeThickness="1.6"
                                      Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      ToolTip="優先度: 高"
                                      Visibility="{Binding ShowFlag, Converter={StaticResource BoolToVis}}"/>
                            </InlineUIContainer><Run Text="{Binding NumberText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11" FontWeight="Normal" Foreground="#A3A3A3"/><Run Text=" "/><Span local:EmojiText.Text="{Binding Title, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- 期限超過ドット -->
                <Ellipse x:Name="OverdueDot" Width="12" Height="12" Fill="#EF4444" Stroke="#FFFFFF" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                         IsHitTestVisible="False"
                         Visibility="{Binding ShowOverdueDot, Converter={StaticResource BoolToVis}}"/>
                <!-- つかんでいる間、元の場所は灰色の枠として残す -->
                <Border x:Name="OriginSlot" CornerRadius="16" Background="#E2E4E9" Visibility="Collapsed"
                        IsHitTestVisible="False"/>
            </Grid>
                <Border x:Name="BottomSlot" Height="{Binding SlotHeight}" CornerRadius="16" Margin="0,8,0,0"
                        Background="#E2E4E9" AllowDrop="True" Visibility="Collapsed"/>
            </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardShadow" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                    <Setter TargetName="CardShadow" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dragging}" Value="True">
                    <Setter TargetName="OriginSlot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CardShadow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="OverdueDot" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropIndicator}" Value="top">
                    <Setter TargetName="TopSlot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropIndicator}" Value="bottom">
                    <Setter TargetName="BottomSlot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 詳細モーダルの小見出し (text-xs neutral-500) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- ヘッダーのナビピル。アクティブは黒塗り -->
        <ControlTemplate x:Key="ActiveNavPill" TargetType="Button">
            <Border Background="#171717" CornerRadius="13" Padding="12,5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="#FFFFFF"/>
            </Border>
        </ControlTemplate>
        <!-- ===== Tags 画面 ===== -->
        <!-- 行内の透明テキスト欄（フォーカスで白背景） -->
        <Style x:Key="InlineEditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TagFieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="56"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#A3A3A3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 色見本ボタン（丸 + 色コード） -->
        <Style x:Key="SwatchToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="6,3,9,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- プリセット色の丸ボタン -->
        <Style x:Key="PresetDot" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Fill="{Binding Converter={StaticResource HexToBrush}}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Stroke" Value="#404040"/>
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="PresetGrid">
            <UniformGrid Columns="8"/>
        </ItemsPanelTemplate>

        <!-- タグ一覧の 1 行 -->
        <DataTemplate x:Key="TagRowTemplate" DataType="{x:Type vm:TagRowVm}">
            <Border x:Name="Row" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <emoji:TextBox Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="emoji"
                                     Width="40" Padding="2,3" FontSize="13" BorderBrush="#E5E5E5"
                                     HorizontalContentAlignment="Center" MaxLength="8"
                                     ToolTip="サイドバーで色付き丸の代わりに表示する絵文字 (任意)"
                                     LostKeyboardFocus="TagField_LostFocus" KeyDown="TagField_KeyDown"/>
                            <Grid Margin="8,0,0,0">
                                <ToggleButton x:Name="SwatchBtn" Style="{StaticResource SwatchToggle}"
                                              IsChecked="{Binding ColorOpen, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="14" Height="14" Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                 Stroke="#E5E5E5" StrokeThickness="1"/>
                                        <TextBlock Text="{Binding Color}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                   Foreground="#525252" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding ColorOpen, Mode=TwoWay}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=SwatchBtn}" Placement="Bottom"
                                       HorizontalOffset="-120" VerticalOffset="4" AllowsTransparency="True">
                                    <Grid Margin="0,0,8,8" LayoutTransform="{Binding Source={x:Static local:UiZoom.Transform}}">
                                        <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="16" Padding="10" Width="230">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{x:Static core:TagPalette.Colors}"
                                                              ItemsPanel="{StaticResource PresetGrid}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource PresetDot}" ToolTip="{Binding}"
                                                                    Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="hex" Tag="#rrggbb"
                                                         Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                         Padding="8,4" LostKeyboardFocus="TagField_LostFocus" KeyDown="TagField_KeyDown"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <Button Command="{Binding ToggleFavoriteCommand}" Margin="6,0,0,0" Padding="8,3" FontSize="14">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="☆"/>
                                        <Setter Property="Foreground" Value="#D4D4D4"/>
                                        <Setter Property="ToolTip" Value="お気に入りにする (サイドバー等でセクション内の先頭に表示)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                <Setter Property="Content" Value="★"/>
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                <Setter Property="ToolTip" Value="お気に入りを解除"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding ToggleArchiveCommand}" Padding="10,4" FontSize="11.5" Margin="2,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="アーカイブ"/>
                                        <Setter Property="Foreground" Value="#737373"/>
                                        <Setter Property="ToolTip" Value="サイドバー・付与候補から隠す (item からは外れない)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Archived}" Value="True">
                                                <Setter Property="Content" Value="復活"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="ToolTip" Value="アーカイブを解除して再びサイドバー・付与候補に出す"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="削除" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11.5"
                                    Margin="2,0,0,0" Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                        <Border Width="150" VerticalAlignment="Center">
                            <Border CornerRadius="11" Padding="10,3" HorizontalAlignment="Left" Background="#F2FFFFFF"
                                    BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}" BorderThickness="1">
                                <TextBlock Text="{Binding Model.Name}" FontSize="11.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                            </Border>
                        </Border>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="name" Tag="タグ名"
                                 Style="{StaticResource InlineEditBox}" FontSize="13" Margin="8,0,8,0"
                                 ToolTip="名前を変更（Enter で確定 / Esc で取り消し）。付いているアイテムにも反映されます"
                                 LostKeyboardFocus="TagField_LostFocus" KeyDown="TagField_KeyDown"/>
                    </DockPanel>
                    <Grid Margin="158,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock Text="PATH" Style="{StaticResource TagFieldLabel}"/>
                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="path" Tag="例: C:\Users\you\projects\foo"
                                     Style="{StaticResource InlineEditBox}" FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11" Padding="6,3"
                                     LostKeyboardFocus="TagField_LostFocus" KeyDown="TagField_KeyDown"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock Text="説明" Style="{StaticResource TagFieldLabel}" Width="36"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="desc" Tag="説明"
                                     Style="{StaticResource InlineEditBox}" FontSize="11.5" Padding="6,3"
                                     LostKeyboardFocus="TagField_LostFocus" KeyDown="TagField_KeyDown"/>
                        </DockPanel>
                    </Grid>
                    <DockPanel Margin="158,4,0,0" Visibility="{Binding CanHaveParent, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PARENT" Style="{StaticResource TagFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding DataContext.TagsAdmin.ParentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding SelectedParent, Mode=TwoWay}" DisplayMemberPath="Name"
                                  FontSize="11.5" Padding="10,3" MinWidth="220" HorizontalAlignment="Left"
                                  ToolTip="このタグが属するカテゴリタグ (p-* / w-*)。設定すると、その親が付いているアイテムでのみ付与候補に出る。"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Archived}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TagGroupHeader" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="20,7"/>
        </Style>
        <!-- 詳細モーダルの幅変更つまみ -->
        <Style x:Key="DetailResizeThumb" TargetType="Thumb">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Margin" Value="-5,20"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ToolTip" Value="ドラッグで幅を変更（ダブルクリックで元の幅）"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Bar" Width="3" CornerRadius="1.5" Background="#93C5FD"
                                    Opacity="0" Margin="0,24"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 設定の文字サイズ（表示倍率）を画面全体に掛ける -->
    <Grid x:Name="RootGrid" AllowDrop="True" PreviewDragOver="Root_PreviewDragOver" DragOver="Root_DragOver"
          LayoutTransform="{Binding Source={x:Static local:UiZoom.Transform}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ヘッダー ================= -->
        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource BoardIcon}" Stroke="#2563EB" StrokeThickness="1.6"
                          Stretch="Uniform" Width="18" Height="16" StrokeLineJoin="Round"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Kanban" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <!-- プロジェクト切替 -->
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              Margin="14,0,0,0" MinWidth="150" FontSize="12" Padding="12,5"
                              VerticalAlignment="Center" ToolTip="プロジェクト">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 検索 -->
                <Border DockPanel.Dock="Left" Width="320" Height="32" VerticalAlignment="Center"
                        Margin="16,0,0,0" Background="#F5F5F5" CornerRadius="16" Padding="12,0,6,0">
                    <Grid>
                        <Path Data="{StaticResource SearchIcon}" Stroke="#A3A3A3" StrokeThickness="1.6"
                              Stretch="Uniform" Width="12" Height="12"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource PlainTextBox}"
                                 Tag="検索 (Ctrl+F)" FontSize="12"
                                 Margin="22,0,26,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="Search_KeyDown"/>
                        <Button Style="{StaticResource IconButton}" Width="20" Height="20"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding SearchText, Converter={StaticResource StringToVis}}"
                                Click="SearchClear_Click" ToolTip="クリア (Esc)">
                            <Path Data="{StaticResource CloseIcon}" Stroke="#A3A3A3" StrokeThickness="1.8"
                                  Stretch="Uniform" Width="8" Height="8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 右側: ステータス + ビュー切替 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Content="Boards" Click="ShowBoards_Click" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowBoards}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource ActiveNavPill}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Tags" Click="ShowTags_Click" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTagsView}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource ActiveNavPill}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Activity" Click="ShowActivity_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActivityView}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource ActiveNavPill}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="設定" Click="ShowSettings_Click" Margin="6,0,0,0" ToolTip="文字サイズなどの設定"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 本体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== サイドバー (プロジェクトタグ) ===== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="224"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="44"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1" Padding="8,7">
                        <Grid>
                            <TextBlock Text="プロジェクトタグ" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                       Visibility="{Binding SidebarCollapsed, Converter={StaticResource InvBoolToVis}}"/>
                            <Button Click="ToggleSidebar_Click" Width="24" Height="24">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="ToolTip" Value="サイドバーを閉じる"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="ToolTip" Value="サイドバーを開く"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Stroke="#A3A3A3" StrokeThickness="1.8" Stretch="Uniform" Width="6" Height="10"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource ChevronLeftIcon}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource ChevronRightIcon}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- タグ検索 (折りたたみ時は非表示) -->
                    <Border DockPanel.Dock="Top" Margin="10,8,10,2" Height="28" Background="#F5F5F5"
                            CornerRadius="14" Padding="10,0,4,0"
                            Visibility="{Binding SidebarCollapsed, Converter={StaticResource InvBoolToVis}}">
                        <Grid>
                            <Path Data="{StaticResource SearchIcon}" Stroke="#A3A3A3" StrokeThickness="1.6"
                                  Stretch="Uniform" Width="11" Height="11"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox x:Name="SidebarSearchBox" Style="{StaticResource PlainTextBox}"
                                     Tag="タグを検索" FontSize="12" Margin="19,0,22,0"
                                     Text="{Binding SidebarQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="名前・説明の部分一致で絞り込み。Enter で先頭を選択、Esc でクリア"
                                     KeyDown="SidebarSearch_KeyDown"/>
                            <Button Style="{StaticResource IconButton}" Width="18" Height="18"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding SidebarQuery, Converter={StaticResource StringToVis}}"
                                    Click="SidebarSearchClear_Click" ToolTip="クリア (Esc)">
                                <Path Data="{StaticResource CloseIcon}" Stroke="#A3A3A3" StrokeThickness="1.8"
                                      Stretch="Uniform" Width="7" Height="7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="0,4,0,12">
                            <Button Style="{StaticResource SidebarItemButton}" DataContext="{Binding AllEntry}"
                                    Content="{Binding}" ContentTemplate="{StaticResource SidebarRowTemplate}"
                                    Click="SidebarAll_Click" ToolTip="Inbox + Doing の件数"/>
                            <Button Style="{StaticResource SidebarItemButton}" DataContext="{Binding TodayEntry}"
                                    Content="{Binding}" ContentTemplate="{StaticResource SidebarRowTemplate}"
                                    Click="SidebarToday_Click" ToolTip="期限が今日以前 (Inbox + Doing)"/>

                            <!-- 仕事 (w-*) -->
                            <StackPanel Visibility="{Binding HasWorkTags, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,4,0,0"/>
                                <ToggleButton Content="仕事" Style="{StaticResource SidebarGroupToggle}"
                                              IsChecked="{Binding WorkGroupOpen}"
                                              ToolTip="クリックで開閉。件数は Inbox + Doing。Ctrl+クリックで複数選択。"/>
                                <ItemsControl ItemsSource="{Binding WorkTags}"
                                              Visibility="{Binding ShowWorkItems, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarItemButton}"
                                                    Content="{Binding}" ContentTemplate="{StaticResource SidebarRowTemplate}"
                                                    Click="SidebarTag_Click" ToolTip="{Binding Label}"
                                                    Visibility="{Binding Matches, Converter={StaticResource BoolToVis}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- プロジェクト (p-*) -->
                            <StackPanel Visibility="{Binding HasProjectTags, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,4,0,0"/>
                                <ToggleButton Content="プロジェクト" Style="{StaticResource SidebarGroupToggle}"
                                              IsChecked="{Binding ProjectGroupOpen}"
                                              ToolTip="クリックで開閉。件数は Inbox + Doing。Ctrl+クリックで複数選択。"/>
                                <ItemsControl ItemsSource="{Binding ProjectTags}"
                                              Visibility="{Binding ShowProjectItems, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarItemButton}"
                                                    Content="{Binding}" ContentTemplate="{StaticResource SidebarRowTemplate}"
                                                    Click="SidebarTag_Click" ToolTip="{Binding Label}"
                                                    Visibility="{Binding Matches, Converter={StaticResource BoolToVis}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="一致するタグがありません" FontSize="11.5" Margin="14,10"
                                       Foreground="{StaticResource FaintBrush}"
                                       Visibility="{Binding SidebarNoMatch, Converter={StaticResource BoolToVis}}"/>

                            <!-- 未分類 -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="{Binding ShowUntagged, Converter={StaticResource BoolToVis}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,4,0,0"/>
                                <Grid Margin="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Stroke="#D4D4D4" StrokeDashArray="2 1.5"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="未分類" FontSize="12" Margin="2,0,0,0"
                                               Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" CornerRadius="7" Padding="6,1" Background="#F5F5F5">
                                        <TextBlock Text="{Binding UntaggedCount}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== メイン ===== -->
            <Grid Grid.Column="1">
                <!-- ボード横並び -->
                <ScrollViewer x:Name="BoardsScroll" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowBoards, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="20,20,4,16" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Boards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BoardVm}">
                                <Grid Margin="0,0,16,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Width" Value="288"/>
                                        <Style.Triggers>
                                            <!-- layout=board (Inbox など): 横に広がるので幅は中身に合わせる -->
                                            <DataTrigger Binding="{Binding IsBoardLayout}" Value="True">
                                                <Setter Property="Width" Value="NaN"/>
                                                <Setter Property="MinWidth" Value="288"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <!-- カラムの影も背面レイヤーに（カラム全体に Effect を掛けると中のカード文字がぼやける） -->
                                <Border CornerRadius="16" Background="#F5F5F5" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.06" Color="#0F172A"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="16"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        AllowDrop="True"
                                        Drop="Column_Drop" DragOver="Column_DragOver"
                                        DragEnter="Column_DragEnter" DragLeave="Column_DragLeave">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ColumnBg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="#EEF4FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <!-- カラムヘッダー: 白 + 上部3pxのボード色 + 件数ピル -->
                                        <Border DockPanel.Dock="Top" CornerRadius="15,15,0,0" Background="#FFFFFF"
                                                BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                BorderThickness="0,3,0,0">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <DockPanel Margin="16,8,8,8">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButton}" Click="BoardSettings_Click"
                                                                ToolTip="ボードの設定（名前・絵文字・色・並び順・追加）">
                                                            <TextBlock Text="⋯" FontSize="14" Foreground="#A3A3A3" Margin="0,-3,0,0"/>
                                                        </Button>
                                                        <Grid Visibility="{Binding HasFilterTags, Converter={StaticResource BoolToVis}}">
                                                            <ToggleButton x:Name="FilterToggle" Style="{StaticResource IconToggle}"
                                                                          IsChecked="{Binding FilterOpen, Mode=TwoWay}"
                                                                          ToolTip="このボードをタグで絞り込み">
                                                                <Path Data="{StaticResource FilterIcon}" StrokeThickness="1.5"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                      Stretch="Uniform" Width="11" Height="11" StrokeLineJoin="Round"/>
                                                            </ToggleButton>
                                                            <Ellipse Width="6" Height="6" Fill="#3B82F6" IsHitTestVisible="False"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                                     Visibility="{Binding HasLocalFilter, Converter={StaticResource BoolToVis}}"/>
                                                            <Popup IsOpen="{Binding FilterOpen, Mode=TwoWay}" StaysOpen="False"
                                                                   PlacementTarget="{Binding ElementName=FilterToggle}"
                                                                   Placement="Bottom" HorizontalOffset="-180" VerticalOffset="4"
                                                                   AllowsTransparency="True" PopupAnimation="Fade">
                                                                <Grid Width="210" Margin="0,0,8,8" LayoutTransform="{Binding Source={x:Static local:UiZoom.Transform}}">
                                                                    <!-- 影は文字を含まない背面レイヤーに掛ける（Effect を掛けた要素は文字ごと画像化されてぼやけるため） -->
                                                                    <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                                                                        <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/>
                                                                    </Border.Effect>
                                                                    </Border>
                                                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="6">
                                                                    <DockPanel>
                                                                        <DockPanel DockPanel.Dock="Top" Margin="6,2,2,4">
                                                                            <Button DockPanel.Dock="Right" Content="クリア" FontSize="11"
                                                                                    Style="{StaticResource GhostButton}" Padding="8,2"
                                                                                    Command="{Binding ClearLocalFilterCommand}"/>
                                                                            <TextBlock Text="タグで絞り込み" Style="{StaticResource SectionHeader}"
                                                                                       VerticalAlignment="Center"/>
                                                                        </DockPanel>
                                                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                                            <ItemsControl ItemsSource="{Binding FilterTags}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <CheckBox IsChecked="{Binding Selected}" Margin="6,4">
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                                                                         VerticalAlignment="Center"
                                                                                                         Fill="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                                                           VerticalAlignment="Center"/>
                                                                                            </StackPanel>
                                                                                        </CheckBox>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                    </DockPanel>
                                                                </Border>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <emoji:TextBlock Text="{Binding Emoji}" FontSize="14" Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"
                                                                         Visibility="{Binding HasEmoji, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <Border CornerRadius="7" Background="#F5F5F5" Padding="7,1"
                                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CountText}" FontSize="10"
                                                                       FontWeight="Medium" Foreground="{StaticResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Border>

                                        <!-- 追加エリア -->
                                        <!-- ボタンと入力欄は同じ最低高さにする。カードを押した瞬間に入力欄が閉じても
                                             カード一覧の位置がずれず、離した位置が同じカードの上に残る（押して離すと開く） -->
                                        <Grid DockPanel.Dock="Top" Margin="8,8,8,0">
                                            <!-- 幅を測るだけの空要素。入力欄の幅をこれに合わせて、長いタイトルは折り返す
                                                 （入力欄の文字幅でカラムが横に伸びないように） -->
                                            <Border x:Name="AddSizer"/>
                                            <Button Style="{StaticResource DashedAddButton}" Padding="12,7" MinHeight="34"
                                                    Visibility="{Binding IsAdding, Converter={StaticResource InvBoolToVis}}"
                                                    Click="BeginAdd_Click">
                                                <TextBlock Text="+ アイテムを追加" FontSize="11.5"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </Button>
                                            <TextBox Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="タイトル..." Padding="12,8" MinHeight="34"
                                                     TextWrapping="Wrap" HorizontalAlignment="Left"
                                                     Width="{Binding ActualWidth, ElementName=AddSizer}"
                                                     Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}"
                                                     KeyDown="NewItem_KeyDown" LostFocus="NewItem_LostFocus">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <!-- layout=board は画面より広くなるので、カード 2 列ぶんで折り返す -->
                                                            <DataTrigger Binding="{Binding IsBoardLayout}" Value="True">
                                                                <Setter Property="MaxWidth" Value="520"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                        <!-- カード一覧 -->
                                        <Grid Margin="8,8,4,0">
                                            <TextBlock Text="カードがありません" FontSize="11.5" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource FaintBrush}" Margin="0,14,4,0"
                                                       VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <DockPanel>
                                                <!-- Done のページング: 一番下までスクロールすると自動で続きを取得。押しても取得できる -->
                                                <Button DockPanel.Dock="Bottom" Content="{Binding MoreText}"
                                                        Style="{StaticResource SoftPillButton}" FontSize="10.5"
                                                        HorizontalAlignment="Center" Margin="0,4,4,8"
                                                        Click="LoadMore_Click"
                                                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
                                                <ListBox ItemsSource="{Binding Items}"
                                                         ItemTemplate="{StaticResource ItemCardTemplate}"
                                                         ScrollViewer.ScrollChanged="BoardList_ScrollChanged"
                                                         Padding="0,4,4,0" Background="Transparent">
                                                    <ListBox.Style>
                                                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                            <!-- 通常 (layout=scroll): 縦スクロール + 仮想化 -->
                                                            <Setter Property="ItemContainerStyle" Value="{StaticResource PlainListItem}"/>
                                                            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                                                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                                            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                                                            <Style.Triggers>
                                                                <!-- layout=board: 上から詰めて下端で次の列へ折り返し、横に広がる（縦スクロールなし）。
                                                                     flex-col flex-wrap + カード幅 w-64 と同じ -->
                                                                <DataTrigger Binding="{Binding IsBoardLayout}" Value="True">
                                                                    <Setter Property="ItemContainerStyle" Value="{StaticResource WrapListItem}"/>
                                                                    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                                                                    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
                                                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                                                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                                                    <Setter Property="Padding" Value="0,4,0,0"/>
                                                                    <Setter Property="ItemsPanel">
                                                                        <Setter.Value>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Vertical" ItemWidth="264"/>
                                                                            </ItemsPanelTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ListBox.Style>
                                                </ListBox>
                                            </DockPanel>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource DashedAddButton}" Width="160" Height="44" VerticalAlignment="Top"
                            Margin="0,0,16,0" Click="AddBoard_Click" ToolTip="ボードの設定を開いて新しいボードを追加">
                        <TextBlock Text="+ ボードを追加" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                    </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 検索結果 -->
                <DockPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" Margin="20">
                    <TextBlock DockPanel.Dock="Top" Text="検索結果" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12" HorizontalAlignment="Center" Width="672"/>
                    <ListBox ItemsSource="{Binding SearchResults}"
                             ItemTemplate="{StaticResource ItemCardTemplate}"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             Width="680" HorizontalAlignment="Center" Padding="0,4,8,0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                </DockPanel>

                <!-- Tags -->
                <ScrollViewer Visibility="{Binding IsTagsView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding TagsAdmin}" MaxWidth="760" Margin="24,24,24,32">
                        <!-- 新規タグ -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="全タグを自動配色" Style="{StaticResource SoftPillButton}"
                                            Command="{Binding ResetAllColorsCommand}"
                                            ToolTip="全タグの色をタグ名から自動算出した色で上書き"/>
                                    <TextBlock Text="新規タグ" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Left" Text="{Binding NewEmoji, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="😀" Width="46" Padding="2,7" FontSize="14" FontFamily="Segoe UI Emoji"
                                             HorizontalContentAlignment="Center" MaxLength="8"
                                             ToolTip="サイドバーで色付き丸の代わりに表示する絵文字 (任意)"/>
                                    <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource PrimaryButton}"
                                            Padding="18,6" Margin="8,0,0,0" Command="{Binding CreateCommand}"/>
                                    <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                                        <ToggleButton x:Name="NewSwatchBtn" Style="{StaticResource SwatchToggle}"
                                                      IsChecked="{Binding NewColorOpen, Mode=TwoWay}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="14" Height="14" Fill="{Binding PreviewColor, Converter={StaticResource HexToBrush}}"
                                                         Stroke="#E5E5E5" StrokeThickness="1"/>
                                                <TextBlock Text="{Binding NewColorLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                           Foreground="#525252" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding NewColorOpen, Mode=TwoWay}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=NewSwatchBtn}" Placement="Bottom"
                                               HorizontalOffset="-140" VerticalOffset="4" AllowsTransparency="True">
                                            <Grid Margin="0,0,8,8" LayoutTransform="{Binding Source={x:Static local:UiZoom.Transform}}">
                                                <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/>
                                                    </Border.Effect>
                                                </Border>
                                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="16" Padding="10" Width="230">
                                                    <StackPanel>
                                                        <Button Content="Auto (タグ名から自動配色)" FontSize="11.5" Padding="8,5"
                                                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                                                Command="{Binding SetNewColorCommand}" CommandParameter="">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SoftPillButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NewColorIsAuto}" Value="True">
                                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <ItemsControl ItemsSource="{x:Static core:TagPalette.Colors}"
                                                                      ItemsPanel="{StaticResource PresetGrid}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource PresetDot}" ToolTip="{Binding}"
                                                                            Command="{Binding DataContext.SetNewColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBox Text="{Binding NewHexInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 Tag="#rrggbb" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas"
                                                                 FontSize="11.5" Padding="8,4"
                                                                 LostKeyboardFocus="NewHex_LostFocus" KeyDown="NewHex_KeyDown"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                    <TextBox x:Name="NewTagNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="タグ名..." Margin="8,0,0,0" Padding="12,7" FontSize="13"
                                             KeyDown="NewTagName_KeyDown"/>
                                </DockPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="path (任意) — 例: C:\Users\you\projects\foo" FontFamily="Cascadia Mono, Consolas"
                                             FontSize="11" Padding="10,6" KeyDown="NewTagName_KeyDown"/>
                                    <TextBox Grid.Column="2" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="説明 (任意)" FontSize="11.5" Padding="10,6" KeyDown="NewTagName_KeyDown"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="プレビュー：" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border CornerRadius="11" Padding="10,3" Background="#F2FFFFFF" BorderThickness="1"
                                            BorderBrush="{Binding PreviewColor, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding PreviewName}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding PreviewColor, Converter={StaticResource HexToBrush}}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- タグ一覧 -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="16" Margin="0,20,0,0">
                            <StackPanel>
                                <DockPanel Margin="20,12">
                                    <TextBox DockPanel.Dock="Right" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="検索..." Width="200" FontSize="12" Padding="12,4"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="タグ一覧" FontSize="13.5" FontWeight="SemiBold"/>
                                        <Run Text="{Binding TotalCount, Mode=OneWay, StringFormat='{}{0} 件'}" FontSize="11.5"
                                             Foreground="#737373"/>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding EmptyText}" FontSize="12.5" Foreground="{StaticResource FaintBrush}"
                                           HorizontalAlignment="Center" Margin="0,16,0,24"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                                <StackPanel Visibility="{Binding HasWork, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource TagGroupHeader}">
                                        <TextBlock FontSize="11.5" Foreground="#737373">
                                            <Run Text="仕事" FontWeight="Medium"/>
                                            <Run Text="{Binding WorkTags.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="#A3A3A3"/>
                                        </TextBlock>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding WorkTags}" ItemTemplate="{StaticResource TagRowTemplate}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource TagGroupHeader}">
                                        <TextBlock FontSize="11.5" Foreground="#737373">
                                            <Run Text="プロジェクト" FontWeight="Medium"/>
                                            <Run Text="{Binding ProjectTags.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="#A3A3A3"/>
                                        </TextBlock>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding ProjectTags}" ItemTemplate="{StaticResource TagRowTemplate}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasOther, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource TagGroupHeader}">
                                        <TextBlock FontSize="11.5" Foreground="#737373">
                                            <Run Text="その他" FontWeight="Medium"/>
                                            <Run Text="{Binding OtherTags.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="#A3A3A3"/>
                                        </TextBlock>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding OtherTags}" ItemTemplate="{StaticResource TagRowTemplate}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasArchived, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource TagGroupHeader}">
                                        <TextBlock FontSize="11.5" Foreground="#737373">
                                            <Run Text="アーカイブ済み" FontWeight="Medium"/>
                                            <Run Text="{Binding ArchivedTags.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="#A3A3A3"/>
                                            <Run Text="  サイドバーや付与候補から非表示。復活させれば元通り。" FontSize="10" Foreground="#A3A3A3"/>
                                        </TextBlock>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding ArchivedTags}" ItemTemplate="{StaticResource TagRowTemplate}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- アクティビティ -->
                <DockPanel Visibility="{Binding IsActivityView, Converter={StaticResource BoolToVis}}" Margin="20">
                    <TextBlock DockPanel.Dock="Top" Text="Activity" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12" HorizontalAlignment="Center" Width="672"/>
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Width="672" HorizontalAlignment="Center" Padding="4">
                        <ListBox ItemsSource="{Binding Activity}"
                                 ItemContainerStyle="{StaticResource PlainListItem}"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding WhenText}" Style="{StaticResource Muted}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" CornerRadius="7" Padding="7,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F3E8FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Actor}" Value="user">
                                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Actor}" FontSize="10" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#7E22CE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Actor}" Value="user">
                                                                    <Setter Property="Foreground" Value="#525252"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <Run Text="{Binding Action, Mode=OneWay}" FontSize="12"/>
                                                <Run Text="{Binding Details, Mode=OneWay}" FontSize="11.5" Foreground="#737373"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ================= 詳細モーダル ================= -->
        <Grid Grid.RowSpan="2" x:Name="DetailOverlay" Background="#4D000000"
              MouseLeftButtonDown="DetailBackdrop_MouseDown"
              MouseLeftButtonUp="DetailBackdrop_MouseUp">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!-- 暗い背景をクリック（押して離す）すると閉じる。下の画面へのクリックは遮る -->
            <!-- 左: 詳細カード / 右: 追加フォーム（開いているときだけ。全体の最大幅を広げて中央に寄せる） -->
            <!-- MaxWidth は 詳細の幅（左右の端をドラッグで変更・ui.json に保存）+ 追加フォームの幅。コードで設定 -->
            <Grid x:Name="DetailHost" Margin="32" VerticalAlignment="Center" MaxWidth="672">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <Grid x:Name="DetailCardHost">
                <!-- 影は文字を含まない背面レイヤーに掛ける（Effect を掛けた要素は文字ごと画像化されてぼやけるため） -->
                <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                    <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.22" Color="#0F172A"/>
                </Border.Effect>
                </Border>
                <Border x:Name="DetailCard" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" MouseLeftButtonDown="DetailCard_MouseDown">
                <DockPanel DataContext="{Binding Detail}">
                    <!-- モーダルヘッダー: ボード選択 + #番号 / アーカイブ・削除・閉じる -->
                    <Border DockPanel.Dock="Top" Padding="20,11"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                        <DockPanel VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <!-- 詳細を開いたまま右側に追加フォームを出す -->
                                <Button Content="＋ 追加" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11.5"
                                        Margin="0,0,2,0" Click="ToggleQuickAdd_Click"
                                        ToolTip="詳細を開いたままアイテムを追加 (Ctrl+N)"/>
                                <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="11.5"
                                        Command="{Binding ToggleArchiveCommand}">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="アーカイブ"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Archived}" Value="True">
                                                            <Setter Property="Text" Value="アーカイブ解除"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="削除" Style="{StaticResource DangerButton}" Padding="10,5"
                                        FontSize="11.5" Margin="2,0,0,0" Click="DeleteItem_Click"/>
                                <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="2,0,0,0"
                                        Click="CloseDetail_Click" ToolTip="閉じる (Esc)">
                                    <Path Data="{StaticResource CloseIcon}" Stroke="#737373" StrokeThickness="1.8"
                                          Stretch="Uniform" Width="9" Height="9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding BoardOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedBoardOption, Mode=TwoWay}"
                                          MinWidth="120" FontSize="12" Padding="12,4" ToolTip="ボードを移動"/>
                                <Button Command="{Binding CopyNumberCommand}" Margin="8,0,0,0" Cursor="Hand"
                                        ToolTip="クリックで #N をコピー (エージェントからの参照番号)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="#F5F5F5" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="{Binding NumberText}" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11" Foreground="#525252"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border CornerRadius="9" Background="#FEF3C7" Padding="8,2" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Archived, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="アーカイブ済み" FontSize="10.5" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,20">
                            <!-- タイトル (フォーカスアウトで自動保存) -->
                            <!-- 入力中も絵文字をカラーで表示する（Emoji.Wpf.TextBox） -->
                            <emoji:TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                     AcceptsReturn="False" Padding="6,4" BorderThickness="0" BorderBrush="Transparent"
                                     LostFocus="AutoSave_LostFocus" KeyDown="TitleBox_KeyDown">
                                <emoji:TextBox.Resources>
                                    <!-- Emoji.Wpf.TextBox は内部にリッチテキスト欄を重ねて描くので、その枠と背景も消す -->
                                    <Style TargetType="emoji:RichTextBox">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style TargetType="RichTextBox">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </emoji:TextBox.Resources>
                                <emoji:TextBox.Style>
                                    <Style TargetType="emoji:TextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Background" Value="#FAFAFA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </emoji:TextBox.Style>
                            </emoji:TextBox>

                            <!-- 期限 -->
                            <TextBlock Text="期限" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <WrapPanel>
                                <TextBox Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="YYYY-MM-DD" Width="112" FontSize="12" Padding="10,5"
                                         LostFocus="AutoSave_LostFocus" KeyDown="DueBox_KeyDown"
                                         Margin="0,0,8,0"/>
                                <Border CornerRadius="9" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                        BorderThickness="1"
                                        Background="{Binding DueStatus, Converter={StaticResource DueBrush}, ConverterParameter=bg}"
                                        BorderBrush="{Binding DueStatus, Converter={StaticResource DueBrush}, ConverterParameter=ring}"
                                        Visibility="{Binding DueStatusText, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="{Binding DueStatusText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding DueStatus, Converter={StaticResource DueBrush}, ConverterParameter=fg}"/>
                                </Border>
                                <Button Content="今日" Command="{Binding SetDueCommand}" CommandParameter="today"
                                        VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SoftPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="明日" Command="{Binding SetDueCommand}" CommandParameter="tomorrow"
                                        VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SoftPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDueTomorrow}" Value="True">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="+7日" Style="{StaticResource SoftPillButton}" Margin="0,0,4,0"
                                        Command="{Binding SetDueCommand}" CommandParameter="week" VerticalAlignment="Center"/>
                                <Button Content="クリア" Style="{StaticResource SoftPillButton}" Background="#FAFAFA"
                                        Foreground="#737373" VerticalAlignment="Center"
                                        Command="{Binding SetDueCommand}" CommandParameter="clear"
                                        Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>

                            <!-- 優先度 -->
                            <TextBlock Text="優先度" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <Border Background="#F5F5F5" CornerRadius="14" Padding="2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedRadio}" Content="低"
                                                 IsChecked="{Binding Priority, Converter={StaticResource StringMatch}, ConverterParameter=low}"/>
                                    <RadioButton Style="{StaticResource SegmentedRadio}" Content="中"
                                                 IsChecked="{Binding Priority, Converter={StaticResource StringMatch}, ConverterParameter=normal}"/>
                                    <RadioButton Style="{StaticResource SegmentedRadio}" Content="高"
                                                 IsChecked="{Binding Priority, Converter={StaticResource StringMatch}, ConverterParameter=high}"/>
                                </StackPanel>
                            </Border>

                            <!-- タグ -->
                            <TextBlock Text="タグ" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="11" Padding="10,3,6,3" Margin="0,0,6,6"
                                                Background="#F2FFFFFF"
                                                BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="×" FontSize="12" Padding="3,0" Margin="3,0,0,0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Opacity="0.6" ToolTip="外す"
                                                        Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                        VerticalAlignment="Center"
                                                        Click="DetachTag_Click" Tag="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="NewTagBox" Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="タグを検索 / 追加… (Enter)" FontSize="12" Padding="12,6"
                                     KeyDown="NewTag_KeyDown"/>
                            <!-- 既存タグの候補（誤入力による新規タグ作成を防ぐ） -->
                            <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="6" Margin="0,6,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasTagSuggestions}" Value="False"/>
                                                    <Condition Binding="{Binding CanCreateTag}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding TagSuggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.AttachSuggestedTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="10" Padding="8,5" Background="Transparent">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                                                             VerticalAlignment="Center"
                                                                             Fill="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                                               Foreground="#262626" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" TargetName="Bd" Value="#FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Command="{Binding CreateTagCommand}" Cursor="Hand"
                                            Visibility="{Binding CanCreateTag, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="10" Padding="8,5" Background="Transparent">
                                                    <TextBlock FontSize="12" Foreground="#2563EB">
                                                        <Run Text="＋ “"/><Run Text="{Binding NewTag, Mode=OneWay}"/><Run Text="” を作成して付ける"/>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" TargetName="Bd" Value="#EFF6FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 説明: Markdown をそのまま編集するテキスト欄。フォーカスを外すと自動保存（Ctrl+S / 閉じるときも保存） -->
                            <TextBlock Text="説明" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     MinHeight="96" FontSize="13" Padding="12,8" VerticalContentAlignment="Top"
                                     Tag="説明を追加..."
                                     LostFocus="AutoSave_LostFocus" KeyDown="DescBox_KeyDown"/>

                            <!-- サブタスク -->
                            <DockPanel Margin="0,22,0,7">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SubtaskSummary}" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="サブタスク" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Subtasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="10" Padding="8,4" Background="Transparent">
                                            <DockPanel>
                                                <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                        Width="20" Height="20" Opacity="0"
                                                        Click="DeleteSubtask_Click" Tag="{Binding}" ToolTip="削除">
                                                    <Path Data="{StaticResource CloseIcon}" Stroke="#A3A3A3"
                                                          StrokeThickness="1.8" Stretch="Uniform" Width="7" Height="7"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Button>
                                                <CheckBox IsChecked="{Binding Done, Mode=TwoWay}"
                                                          Click="ToggleSubtask_Click" Tag="{Binding}"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="13"
                                                           VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#262626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#FAFAFA"/>
                                                <Setter TargetName="Del" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Text="{Binding NewSubtask, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="+ サブタスクを追加" Margin="0,6,0,0" FontSize="12.5" Padding="12,6"
                                     KeyDown="NewSubtask_KeyDown"/>

                            <!-- コメント -->
                            <TextBlock Text="コメント" Style="{StaticResource FieldLabel}" Margin="0,22,0,7"/>
                            <!-- 入力欄は一覧の上（新しいコメントが上に積まれるのと揃える） -->
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                    <Button Content="投稿＋Assigned" Style="{StaticResource AssignButton}"
                                            Padding="10,5" FontSize="11.5" Margin="0,0,0,4"
                                            ToolTip="コメントを投稿して Assigned へ移動 (Ctrl+Shift+Enter)"
                                            Command="{Binding AddCommentAndAssignCommand}"/>
                                    <Button Content="投稿" Style="{StaticResource AccentOutlineButton}"
                                            Padding="16,5" FontSize="11.5"
                                            Command="{Binding AddCommentCommand}"/>
                                </StackPanel>
                                <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap" FontSize="12.5"
                                         Tag="コメントを追加... (Ctrl+Enter で投稿 / Ctrl+Shift+Enter で投稿＋Assigned)" Padding="12,7"
                                         KeyDown="NewComment_KeyDown"
                                         VerticalContentAlignment="Top"/>
                            </DockPanel>
                            <!-- 新しい順（上が最新） -->
                            <ItemsControl ItemsSource="{Binding Comments}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="12" Padding="12,8" Margin="0,0,0,6"
                                                Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                    <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                            Width="20" Height="20" Opacity="0"
                                                            Click="DeleteComment_Click" Tag="{Binding}" ToolTip="削除">
                                                        <Path Data="{StaticResource CloseIcon}" Stroke="#A3A3A3"
                                                              StrokeThickness="1.8" Stretch="Uniform" Width="7" Height="7"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Button>
                                                    <TextBlock FontSize="11" VerticalAlignment="Center">
                                                        <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Setter Property="Foreground" Value="#525252"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAgent}" Value="True">
                                                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                        <Run Text="  "/><Run Text="{Binding WhenText, Mode=OneWay}" Foreground="#A3A3A3"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <!-- 本文は簡易 Markdown プレビュー（MarkdownMini → FlowDocument）。
                                                     読み取り専用の RichTextBox なのでドラッグで選択してコピーできる -->
                                                <RichTextBox local:MarkdownMini.Source="{Binding Content}"
                                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                             BorderThickness="0" Background="Transparent" Padding="0"
                                                             Foreground="#262626" FontSize="12.5"
                                                             VerticalScrollBarVisibility="Disabled"
                                                             HorizontalScrollBarVisibility="Disabled">
                                                    <RichTextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="コピー" Command="ApplicationCommands.Copy"/>
                                                            <MenuItem Header="本文をコピー（Markdown）" Click="CopyComment_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </RichTextBox.ContextMenu>
                                                </RichTextBox>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Del" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- アクティビティ -->
                            <!-- 操作履歴は普段は畳んでおき、見出しをクリックしたときだけ開く（開くたびに畳んだ状態から） -->
                            <ToggleButton IsChecked="{Binding ShowActivity}" Margin="0,22,0,7" HorizontalAlignment="Left"
                                          Cursor="Hand" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,2">
                                            <TextBlock x:Name="Label" FontSize="11.5" Foreground="{StaticResource MutedBrush}">
                                                <Run x:Name="Arrow" Text="▸"/><Run Text=" アクティビティ ("/><Run Text="{Binding Activity.Count, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="▾"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Label" Property="Foreground" Value="#262626"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <StackPanel Visibility="{Binding ShowActivity, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="まだ操作履歴がありません" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                           Visibility="{Binding Activity.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"/>
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}" FontSize="10.5"
                                                           Foreground="{StaticResource FaintBrush}" Margin="8,0,0,0"/>
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Actor, Mode=OneWay}" Foreground="#A3A3A3"/>
                                                    <Run Text="{Binding Action, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
                <!-- 左右の端をドラッグで幅を変更（中央寄せなので両側に広がる）。ダブルクリックで既定幅に戻す -->
                <Thumb Style="{StaticResource DetailResizeThumb}" HorizontalAlignment="Left" Tag="left"
                       DragDelta="DetailResize_DragDelta" DragCompleted="DetailResize_DragCompleted"
                       MouseDoubleClick="DetailResize_DoubleClick"/>
                <Thumb Style="{StaticResource DetailResizeThumb}" HorizontalAlignment="Right" Tag="right"
                       DragDelta="DetailResize_DragDelta" DragCompleted="DetailResize_DragCompleted"
                       MouseDoubleClick="DetailResize_DoubleClick"/>
            </Grid>

            <!-- 追加フォーム（詳細の「＋ 追加」で開く。追加に必要な項目だけ） -->
            <Grid Grid.Column="1" x:Name="QuickAddPanel" Width="312" Margin="12,0,0,0" VerticalAlignment="Top"
                  Visibility="{Binding QuickAdd, Converter={StaticResource NullToVis}}">
                <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.22" Color="#0F172A"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="QuickAddCard" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" MouseLeftButtonDown="QuickAddCard_MouseDown">
                    <DockPanel DataContext="{Binding QuickAdd}">
                        <Border DockPanel.Dock="Top" Padding="20,11"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,5"
                                        Click="ToggleQuickAdd_Click" ToolTip="追加フォームを閉じる">
                                    <Path Data="{StaticResource CloseIcon}" Stroke="#737373" StrokeThickness="1.8"
                                          Stretch="Uniform" Width="9" Height="9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <TextBlock Text="アイテムを追加" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="20,12"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0">
                            <Button Content="追加" Style="{StaticResource PrimaryButton}" Padding="18,6"
                                    HorizontalAlignment="Right" Click="QuickAddCreate_Click" ToolTip="追加 (Enter)"/>
                        </Border>
                        <StackPanel Margin="20,14,20,16">
                            <TextBlock Text="ボード" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                            <ComboBox ItemsSource="{Binding BoardOptions}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedBoardOption, Mode=TwoWay}"
                                      HorizontalAlignment="Left" MinWidth="140" FontSize="12" Padding="12,4"/>

                            <TextBlock Text="タイトル" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <TextBox x:Name="QuickAddTitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="タイトル... (Enter で追加)" FontSize="13" Padding="12,7"
                                     KeyDown="QuickAddTitle_KeyDown"/>

                            <TextBlock Text="期限" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <TextBox Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="YYYY-MM-DD" Width="112" FontSize="12" Padding="10,5" HorizontalAlignment="Left"
                                     KeyDown="QuickAddTitle_KeyDown"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="今日" Command="{Binding SetDueCommand}" CommandParameter="today"
                                        VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SoftPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="明日" Command="{Binding SetDueCommand}" CommandParameter="tomorrow"
                                        VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SoftPillButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDueTomorrow}" Value="True">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="+7日" Style="{StaticResource SoftPillButton}" Margin="0,0,4,0"
                                        Command="{Binding SetDueCommand}" CommandParameter="week" VerticalAlignment="Center"/>
                                <Button Content="クリア" Style="{StaticResource SoftPillButton}" Background="#FAFAFA"
                                        Foreground="#737373" VerticalAlignment="Center"
                                        Command="{Binding SetDueCommand}" CommandParameter="clear"
                                        Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>

                            <TextBlock Text="優先度" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <Border Background="#F5F5F5" CornerRadius="14" Padding="2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedRadio}" Content="低" GroupName="QuickAddPriority"
                                                 IsChecked="{Binding Priority, Converter={StaticResource StringMatch}, ConverterParameter=low}"/>
                                    <RadioButton Style="{StaticResource SegmentedRadio}" Content="中" GroupName="QuickAddPriority"
                                                 IsChecked="{Binding Priority, Converter={StaticResource StringMatch}, ConverterParameter=normal}"/>
                                    <RadioButton Style="{StaticResource SegmentedRadio}" Content="高" GroupName="QuickAddPriority"
                                                 IsChecked="{Binding Priority, Converter={StaticResource StringMatch}, ConverterParameter=high}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="タグ" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="11" Padding="10,3,6,3" Margin="0,0,6,6"
                                                Background="#F2FFFFFF"
                                                BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="×" FontSize="12" Padding="3,0" Margin="3,0,0,0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Opacity="0.6" ToolTip="外す"
                                                        Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="既存タグを検索… (Enter)" FontSize="12" Padding="12,6"
                                     KeyDown="QuickAddTag_KeyDown"/>
                            <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="6" Margin="0,6,0,0"
                                    Visibility="{Binding HasTagSuggestions, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding TagSuggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.AttachSuggestedTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="10" Padding="8,5" Background="Transparent">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                           Foreground="#262626" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" TargetName="Bd" Value="#FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>
        </Grid>

        <!-- ================= ボード設定モーダル ================= -->
        <Grid Grid.RowSpan="2" x:Name="BoardSettingsOverlay" Background="#4D000000"
              MouseLeftButtonDown="BoardSettingsBackdrop_MouseDown"
              MouseLeftButtonUp="BoardSettingsBackdrop_MouseUp">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BoardSettings}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid MaxWidth="720" Margin="32" VerticalAlignment="Center">
                <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.22" Color="#0F172A"/>
                    </Border.Effect>
                </Border>
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16">
                    <DockPanel DataContext="{Binding BoardSettings}">
                        <Border DockPanel.Dock="Top" Padding="20,12"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Click="CloseBoardSettings_Click" ToolTip="閉じる (Esc)">
                                    <Path Data="{StaticResource CloseIcon}" Stroke="#737373" StrokeThickness="1.8"
                                          Stretch="Uniform" Width="10" Height="10"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <TextBlock Text="ボードの設定" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- 新規ボード -->
                        <Border DockPanel.Dock="Bottom" Padding="20,12"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource PrimaryButton}"
                                        Padding="16,5" Margin="8,0,0,0" Command="{Binding CreateCommand}"/>
                                <emoji:TextBox DockPanel.Dock="Left" Text="{Binding NewEmoji, UpdateSourceTrigger=PropertyChanged}"
                                               Width="44" Padding="2,5" FontSize="13" MaxLength="8"
                                               HorizontalContentAlignment="Center"
                                               ToolTip="絵文字 (任意)" KeyDown="NewBoard_KeyDown"/>
                                <TextBox x:Name="NewBoardNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="新しいボードの名前 (Enter で追加)" FontSize="12.5" Padding="10,5" Margin="8,0,0,0"
                                         KeyDown="NewBoard_KeyDown"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BoardRowVm}">
                                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                                                Padding="14,8">
                                            <DockPanel>
                                                <!-- 並び替え -->
                                                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center"
                                                            Margin="0,0,8,0">
                                                    <Button Style="{StaticResource IconButton}" Width="20" Height="16"
                                                            Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                                            ToolTip="左へ（前へ）">
                                                        <TextBlock Text="▲" FontSize="8" Foreground="#A3A3A3"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="20" Height="16"
                                                            Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                                            ToolTip="右へ（後へ）">
                                                        <TextBlock Text="▼" FontSize="8" Foreground="#A3A3A3"/>
                                                    </Button>
                                                </StackPanel>
                                                <emoji:TextBox DockPanel.Dock="Left" Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}"
                                                               AutomationProperties.Name="emoji"
                                                               Width="44" Padding="2,4" FontSize="14" BorderBrush="#E5E5E5"
                                                               HorizontalContentAlignment="Center" MaxLength="8"
                                                               VerticalAlignment="Center"
                                                               ToolTip="ボード名の前に表示する絵文字 (任意)"
                                                               LostKeyboardFocus="BoardField_LostFocus" KeyDown="BoardField_KeyDown"/>

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Margin="8,0,0,0">
                                                        <ToggleButton x:Name="BoardSwatchBtn" Style="{StaticResource SwatchToggle}"
                                                                      IsChecked="{Binding ColorOpen, Mode=TwoWay}" ToolTip="ボードの色（見出し上部の線）">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="14" Height="14" Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                                         Stroke="#E5E5E5" StrokeThickness="1"/>
                                                                <TextBlock Text="{Binding Color}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                                           Foreground="#525252" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <Popup IsOpen="{Binding ColorOpen, Mode=TwoWay}" StaysOpen="False"
                                                               PlacementTarget="{Binding ElementName=BoardSwatchBtn}" Placement="Bottom"
                                                               HorizontalOffset="-120" VerticalOffset="4" AllowsTransparency="True">
                                                            <Grid Margin="0,0,8,8" LayoutTransform="{Binding Source={x:Static local:UiZoom.Transform}}">
                                                                <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/>
                                                                    </Border.Effect>
                                                                </Border>
                                                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                        CornerRadius="16" Padding="10" Width="230">
                                                                    <StackPanel>
                                                                        <ItemsControl ItemsSource="{x:Static core:TagPalette.Colors}"
                                                                                      ItemsPanel="{StaticResource PresetGrid}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Button Style="{StaticResource PresetDot}" ToolTip="{Binding}"
                                                                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                            CommandParameter="{Binding}"/>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AutomationProperties.Name="hex" Tag="#rrggbb"
                                                                                 Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                                                 Padding="8,4" LostKeyboardFocus="BoardField_LostFocus" KeyDown="BoardField_KeyDown"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Popup>
                                                    </Grid>
                                                    <CheckBox IsChecked="{Binding IsDone}" Content="完了扱い" FontSize="11.5"
                                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                                              ToolTip="ここへ移したアイテムに完了日時を付ける（Done ボード用。30 件ずつ表示）"/>
                                                    <CheckBox IsChecked="{Binding WrapLayout}" Content="折り返し" FontSize="11.5"
                                                              Margin="10,0,0,0" VerticalAlignment="Center"
                                                              ToolTip="縦スクロールせず、下端で次の列に折り返して横に広げる"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} 件'}" FontSize="11"
                                                               Foreground="#A3A3A3" Width="48" TextAlignment="Right"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <Button Content="削除" Style="{StaticResource DangerButton}" Padding="10,4"
                                                            FontSize="11.5" Margin="6,0,0,0" Command="{Binding DeleteCommand}"/>
                                                </StackPanel>

                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="name" Tag="ボード名"
                                                         Style="{StaticResource InlineEditBox}" FontSize="13" FontWeight="SemiBold"
                                                         Margin="6,0,0,0" VerticalAlignment="Center"
                                                         ToolTip="名前を変更（Enter で確定 / Esc で取り消し）。Inbox / Doing はサイドバー件数の判定に名前を使うので注意"
                                                         LostKeyboardFocus="BoardField_LostFocus" KeyDown="BoardField_KeyDown"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 複数選択バー (Ctrl+クリックで選択中のとき) ================= -->
        <Grid x:Name="SelectionBar" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Color="#0F172A"/>
                </Border.Effect>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="14,4,6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#1D4ED8" FontWeight="SemiBold"
                               Text="{Binding SelectedCount, StringFormat='{}{0} 件選択中'}"/>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource FaintBrush}"
                               Margin="8,0,6,0" Text="Ctrl+クリックで追加 / Ctrl+C で番号をコピー"/>
                    <Button Style="{StaticResource IconButton}" Click="SelectionMenu_Click" ToolTip="選択中のアイテムの操作">
                        <TextBlock Text="⋯" FontSize="14" Foreground="#737373" Margin="0,-3,0,0"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="ClearSelection_Click" ToolTip="選択を解除 (Esc)">
                        <Path Data="{StaticResource CloseIcon}" Stroke="#737373" StrokeThickness="1.5"
                              Stretch="Uniform" Width="9" Height="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 設定モーダル（文字サイズ・詳細の幅） ================= -->
        <Grid Grid.RowSpan="2" x:Name="SettingsOverlay" Background="#4D000000"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="SettingsBackdrop_MouseDown"
              MouseLeftButtonUp="SettingsBackdrop_MouseUp">
            <Grid MaxWidth="520" Margin="32" VerticalAlignment="Center">
                <Border CornerRadius="16" Background="#FFFFFF" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.22" Color="#0F172A"/>
                    </Border.Effect>
                </Border>
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="20,12"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Click="CloseSettings_Click" ToolTip="閉じる (Esc)">
                                    <Path Data="{StaticResource CloseIcon}" Stroke="#737373" StrokeThickness="1.8"
                                          Stretch="Uniform" Width="10" Height="10"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <TextBlock Text="設定" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <StackPanel Margin="20,16,20,20">
                            <!-- 文字サイズ -->
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding UiScaleText}" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="文字サイズ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="画面全体（ポップアップ・メニューを含む）の大きさを変えます。Ctrl + マウスホイール、Ctrl + ; / Ctrl + - / Ctrl + 0 でも変更できます。"/>
                            <WrapPanel>
                                <Button Content="−" Width="34" Margin="0,0,6,6" Tag="-" Click="UiScaleStep_Click" ToolTip="5% 小さく (Ctrl + -)"/>
                                <Button Content="80%" Margin="0,0,6,6" Tag="0.8" Click="UiScalePreset_Click"/>
                                <Button Content="90%" Margin="0,0,6,6" Tag="0.9" Click="UiScalePreset_Click"/>
                                <Button Content="100%" Margin="0,0,6,6" Tag="1.0" Click="UiScalePreset_Click" ToolTip="Ctrl + 0"/>
                                <Button Content="110%" Margin="0,0,6,6" Tag="1.1" Click="UiScalePreset_Click"/>
                                <Button Content="125%" Margin="0,0,6,6" Tag="1.25" Click="UiScalePreset_Click"/>
                                <Button Content="150%" Margin="0,0,6,6" Tag="1.5" Click="UiScalePreset_Click"/>
                                <Button Content="＋" Width="34" Margin="0,0,6,6" Tag="+" Click="UiScaleStep_Click" ToolTip="5% 大きく (Ctrl + ;)"/>
                            </WrapPanel>

                            <!-- 詳細の幅 -->
                            <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,14,0,14"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="既定に戻す" Click="ResetDetailWidth_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock>
                                        <Run Text="詳細の幅" FontWeight="SemiBold"/>
                                        <Run Text="{Binding DetailWidthText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="詳細を開いて左右の端をドラッグすると変更できます（次回も同じ幅で開きます）。"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= トースト通知 ================= -->
        <Grid Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <!-- 影は文字を含まない背面レイヤーに掛ける（Effect を掛けた要素は文字ごと画像化されてぼやけるため） -->
            <Border CornerRadius="16" Background="#171717" IsHitTestVisible="False">
                <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#0F172A"/>
            </Border.Effect>
            </Border>
            <Border Background="#171717" CornerRadius="16" Padding="16,8" IsHitTestVisible="False" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Notice}" FontSize="12" FontWeight="Medium" Foreground="#FFFFFF"/>
        </Border>
        </Grid>
    </Grid>
</Window>
